    TC_LUT -->|"tc"| NORMAL_F
    TC_LUT -->|"tc"| CHROMA_F

    STRONG_F -->|"p_o, q_o"| BLK_BUF
    NORMAL_F -->|"p_o, q_o"| BLK_BUF
