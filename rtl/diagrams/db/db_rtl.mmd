        LEFT_BUF["Left Line Buffers<br/>left_y_r[15:0] 128b<br/>left_u_r[7:0] 128b<br/>left_v_r[7:0] 128b"]
        TL_BUF["Top-Left Buffers<br/>y_tl_r, u_tl_r, v_tl_r"]
        BLK_BUF["Block Storage<br/>block[7:0] 128b<br/>right_block_0/1"]
        PQ_MUX["P/Q Block MUX<br/>dbf_p_o[127:0]<br/>dbf_q_o[127:0]<br/>is_ver_o"]
        SAO_BUF["SAO Input Buffer<br/>rec_line_i_0..5[47:0]<br/>ori_line_i_0..3[31:0]"]
        OUT_MUX["Output Reorder<br/>rec_pxl_o[255:0]"]
    end

    subgraph "db_bs"
        TU_EDGE["db_tu_edge<br/>16 vert + 7 horiz edges"]
        PU_EDGE["db_pu_edge<br/>PU partition edges"]
        QP_MOD["db_qp<br/>QP modification flag"]
        TUPU["db_tupu_ram_sp_64x32"]
        CBF["db_cbf_ram_sp_64x16"]
        QP_RAM["db_qp_ram_sp_64x20"]
    end

    subgraph "db_mv"
        MV_BUF["db_mv_ram_sp_64x20<br/>db_mv_ram_sp_512x20"]
        MV_CMP["MV Comparison<br/>|mv_p - mv_q| > 3"]
    end

    subgraph "db_filter"
