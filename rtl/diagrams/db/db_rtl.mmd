```mermaid
graph LR
    subgraph "External Interfaces"
        SYS["Pipeline Interface<br/>sys_start_i, sys_done_o<br/>sys_ctu_x/y_i[5:0]"]
        RC_QP["rc_qp_i[5:0]"]
        MB["CTU Info<br/>mb_type_i<br/>mb_partition_i[20:0]<br/>mb_p_pu_mode_i[41:0]<br/>mb_cbf_i/u_i/v_i[255:0]"]
        REC_IF["Rec Memory IF<br/>rec_rd/wr_*<br/>256-bit data"]
        ORI_IF["Original Pixel IF<br/>ori_*<br/>256-bit data"]
        FETCH_IF["Fetch Store IF<br/>fetch_wen_o<br/>fetch_wdata_o[127:0]"]
        TOP_IF["Top Pixel IF<br/>top_ren_o<br/>top_rdata_i[31:0]"]
