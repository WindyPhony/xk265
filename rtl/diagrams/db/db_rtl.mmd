        STRONG_F["db_strong_filter<br/>3 pixels/side<br/>clip(p, q, ±tc*2)"]
        NORMAL_F["db_normal_filter<br/>1-2 pixels/side<br/>not_nature_edge[3:0]"]
        CHROMA_F["db_chroma_filter<br/>1 pixel/side<br/>INTRA chroma only"]
        FLT_MUX["Filter Output MUX<br/>Priority: chroma → none → strong → normal"]
    end

    subgraph "sao_top"
        SAO_M["sao_mode<br/>EO0/EO1/EO2/EO3/BO"]
        SAO_S["sao_statistic<br/>Per-direction/band accum"]
        SAO_C["sao_cal_offset<br/>Offset computation"]
        SAO_T["sao_type_decision<br/>Best type selection"]
        SAO_A["sao_add_offset<br/>Offset application"]
        SAO_D["sao_bo_predecision<br/>BO candidate pre-select"]
    end

