---
title: PREI RTL-Level Block Diagram
---
flowchart LR
    subgraph EXT["External Interface"]
        CLK["clk"]
        RSTN["rstn"]
        START["prei_start_i"]
        PIXEL["prei_cur_data_i[255:0]"]
        RC_IN["actual_bitnum_i[15:0]<br/>rc_ctu_x_i[5:0]<br/>rc_ctu_y_i[5:0]"]
        RC_REG["reg_k[15:0]<br/>reg_bitnum_i[31:0]<br/>reg_ROI_*<br/>reg_initial/max/min/delta_qp"]
        POSI_RD["posi_md_ena_i<br/>posi_md_addr_i[8:0]"]
        SEL["sel_mod_2_i"]
    end

    subgraph WRAPPER["prei_top_buf (rtl/top/prei_top_buf.v:16)"]
        ADDR_REMAP["Address Remap<br/>posi &lt; 84 → addr+1<br/>posi ≥ 84 → 21+(posi-84)/4<br/>(combinational)"]
        PP_MUX["Ping-Pong Mux<br/>sel=0: wr→RAM0, rd→RAM1<br/>sel=1: wr→RAM1, rd→RAM0"]
        MRAM0["prei_md_ram_sp_85x6<br/>──────────<br/>RAM 0<br/>85 × 6-bit SRAM<br/>(ram_1p behavioral)"]
        MRAM1["prei_md_ram_sp_85x6<br/>──────────<br/>RAM 1<br/>85 × 6-bit SRAM<br/>(ram_1p behavioral)"]
    end

    subgraph TOP["prei_top (rtl/prei/prei_top.v:13)"]
        direction LR
        subgraph MD_PATH["Mode Decision Pipeline"]
            direction LR

            subgraph FETCH_STAGE["Stage 1: Pixel Fetch"]
                FETCH8["fetch8x8<br/>──────────<br/>rf_512bit[511:0] register<br/>2×256-bit assembly<br/>──────────<br/>cnt[5:0]: 0→40<br/>blockcnt[6:0]: 0→64<br/>md_ren_o (cnt 0-17)<br/>md_size_o=01<br/>md_4x4_x/y from blockcnt"]
            end

            subgraph EXTRACT_STAGE["Stage 2: Data Extraction"]
                MDFETCH["md_fetch<br/>──────────<br/>rf_512bit → x1/x2/x3<br/>Mux: cnt 5→40<br/>x1[23:0] = row A<br/>x2[23:0] = row B<br/>x3[23:0] = row C<br/>(3 × 3 pixels × 8-bit)"]
            end

            subgraph GRAD_STAGE["Stage 3: Gradient"]
                GXGY["gxgy<br/>──────────<br/>Sobel 3×3 operator<br/>gy = x1[0]+2·x1[1]+x1[2]<br/>     -x3[0]-2·x3[1]-x3[2]<br/>gx = x1[0]+2·x2[0]+x3[0]<br/>     -x1[2]-2·x2[2]-x3[2]<br/>Output: gx[10:0], gy[10:0]<br/>(signed)"]
            end

            subgraph COST_STAGE["Stage 4: Angular Cost"]
                COUNTER["counter<br/>──────────<br/>32 modes (2-33):<br/>modeN_tmp = cos(N)·gx + sin(N)·gy<br/>modeN += |modeN_tmp|<br/>──────────<br/>Pipeline:<br/>counterrun1 → clear + project<br/>counterrun2 → accumulate<br/>Output: mode2..mode33 [21:0]"]
            end

            subgraph COMPARE_STAGE["Stage 5: Best Angle"]
                COMPARE["compare<br/>──────────<br/>8×8: seq compare cnt 3-33<br/>bestmode[5:0], modebest[21:0]<br/>──────────<br/>16×16: sum16 = adda16+addb16<br/>bestmode16[5:0]<br/>──────────<br/>32×32: sum32 = adda32+addb32<br/>bestmode32[5:0]<br/>──────────<br/>64×64: sum64 = adda64+addb64<br/>bestmode64[5:0]<br/>modebest64[27:0]"]
            end

            subgraph DC_STAGE["Stage 6: DC/Planar Decision"]
                DCPLANAR["dc_planar<br/>──────────<br/>modedata = Σ(|gx|+|gy|)<br/>Accum: 8→16→32→64<br/>──────────<br/>Thresholds:<br/>DC8=288 DC16=1152<br/>DC32=4608 DC64=18432<br/>Plan8-64=32<br/>──────────<br/>if &lt;DC → DC (mode 1)<br/>elif &gt;Plan·mod → Planar (mode 0)<br/>else → best angle<br/>Output: bestmode_o/16/32/64_o"]
            end

            subgraph WRITE_STAGE["Stage 7: Mode Write"]
                MODWRITE["mode_write<br/>──────────<br/>cnt=11: 8×8 write<br/>  addr=blockcnt+19<br/>  data=bestmode<br/>cnt=12: 16×16 write<br/>  addr=blockcnt[6:2]+4<br/>  data=bestmode16<br/>cnt=13: 32×32 write<br/>  addr=blockcnt[6:4]<br/>  data=bestmode32<br/>cnt=14: 64×64 write<br/>  addr=0<br/>  data=bestmode64"]
            end

            subgraph CTRL_BLOCK["Controller"]
                CTRL["control<br/>──────────<br/>cyclecnt[5:0]: 0→40<br/>blockcnt[6:0]: 0→65<br/>──────────<br/>newblock=(cnt==40)<br/>gxgyrun=(cnt==5∧b≠64)<br/>counterrun1=gxgyrun<br/>counterrun2=counterrun1<br/>finish=(b==65∧cnt==15)"]
            end
        end

        subgraph RC_BLOCK["Rate Control Pipeline"]
            RC["rate_control<br/>──────────<br/>11-cycle pipeline:<br/>cnt=1: accumulate modebest64<br/>cnt=2: predict = modebest_7·k>>28<br/>cnt=3: actual_big = frame>predict<br/>cnt=4: diff = |frame-predict|<br/>cnt=5: diff_level (L1/L2 thresholds)<br/>cnt=6: qp_tmp = init ± diff_level<br/>cnt=7: ROI_hit check<br/>cnt=8: qp_ROI adjustment<br/>cnt=9: clamp(min,max) → rc_qp_o<br/>cnt=10: rc_done_o"]
            SHIFT_REG["modebest_1..7<br/>7 × 39-bit shift register<br/>(RC accumulator chain)"]
        end
    end

    %% External → Wrapper
    START --> TOP
    PIXEL -->|"256-bit pixel bus"| FETCH8
    POSI_RD --> ADDR_REMAP
    ADDR_REMAP --> PP_MUX
    SEL --> PP_MUX

    %% Wrapper → RAM
    PP_MUX --> MRAM0
    PP_MUX --> MRAM1

    %% Mode Decision Pipeline Flow
    FETCH8 -->|"rf_512bit[511:0]"| MDFETCH
    MDFETCH -->|"x1[23:0]<br/>x2[23:0]<br/>x3[23:0]"| GXGY
    GXGY -->|"gx[10:0]<br/>gy[10:0]"| COUNTER
    GXGY -->|"gx[10:0]<br/>gy[10:0]"| DCPLANAR
    COUNTER -->|"mode2..mode33<br/>[21:0]"| COMPARE
    COMPARE -->|"bestmode[5:0]<br/>modebest[21:0]<br/>bestmode16/32/64<br/>modebest16/32/64"| DCPLANAR
    COMPARE -->|"bestmode,<br/>bestmode16/32/64"| MODWRITE
    DCPLANAR -->|"bestmode_o/16/32/64_o"| MODWRITE

    %% Control Flow
    CTRL -->|"gxgyrun"| GXGY
    CTRL -->|"counterrun1"| COUNTER
    CTRL -->|"counterrun2"| COUNTER
    CTRL -->|"cyclecnt, blockcnt"| FETCH8
    CTRL -.->|"finish"| TOP

    %% Mode Write → RAM
    MODWRITE -->|"md_we<br/>md_waddr[6:0]<br/>md_wdata[5:0]"| PP_MUX

    %% Rate Control
    COMPARE -->|"modebest64[27:0]"| RC
    TOP -->|"md_done_w"| RC
    RC --> SHIFT_REG
    RC -.->|"rc_qp_o[5:0]"| TOP
    RC -.->|"rc_done_o"| TOP

    %% POSI Read
    MRAM0 -->|"posi_md_data_0[5:0]"| PP_MUX
    MRAM1 -->|"posi_md_data_1[5:0]"| PP_MUX
    PP_MUX -->|"posi_md_data_o[5:0]"| POSI_RD

    %% Done
    TOP -.->|"prei_done_o"| EXT

    %% Style
    classDef external fill:#f5f5f5,stroke:#999,color:#000
    classDef wrapper fill:#4a90d9,stroke:#2c5f8a,color:#fff,font-weight:bold
    classDef core fill:#d9534f,stroke:#a94442,color:#fff,font-weight:bold
    classDef fetch fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef gradient fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef decision fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef ctrlBlock fill:#e8a838,stroke:#b07d28,color:#000,font-weight:bold
    classDef writeBlock fill:#34495e,stroke:#2c3e50,color:#fff,font-weight:bold
    classDef rcBlock fill:#27ae60,stroke:#1e8449,color:#fff,font-weight:bold
    classDef memBlock fill:#5cb85c,stroke:#3d8b3d,color:#fff,font-weight:bold

    class CLK,RSTN,START,PIXEL,RC_IN,RC_REG,POSI_RD,SEL external
    class ADDR_REMAP,PP_MUX wrapper
    class TOP,MD_PATH,CORE core
    class FETCH8,MDFETCH fetch
    class GXGY gradient
    class COUNTER gradient
    class COMPARE,DCPLANAR decision
    class CTRL ctrlBlock
    class MODWRITE writeBlock
    class RC,SHIFT_REG,RC_BLOCK rcBlock
    class MRAM0,MRAM1 memBlock
