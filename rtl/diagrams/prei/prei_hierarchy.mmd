---
title: PREI Module Hierarchy
---
graph TB
    subgraph WRAPPER["prei_top_buf — Wrapper (rtl/top/prei_top_buf.v:16)"]
        direction TB
        BUF_LABEL["prei_top_buf<br/>Ping-pong mode RAM<br/>Address remap"]

        subgraph MODE_RAM["Mode RAM (×2, Ping-Pong)"]
            RAM0["prei_md_ram_sp_85x6<br/>RAM 0<br/>85 × 6-bit<br/>(rtl/mem/)"]
            RAM1["prei_md_ram_sp_85x6<br/>RAM 1<br/>85 × 6-bit<br/>(rtl/mem/)"]
        end

        REMAP["Address Remap<br/>posi_addr &lt; 84 → addr+1<br/>posi_addr ≥ 84 → 21+(addr-84)/4"]
    end

    subgraph TOP["prei_top — Core (rtl/prei/prei_top.v:13)"]
        direction TB
        TOP_LABEL["prei_top<br/>Mode Decision + Rate Control"]

        subgraph MD["hevc_md_top → md_top — Mode Decision"]
            direction TB
            MDTOP["hevc_md_top<br/>(rtl/prei/hevc_md_top.v:13)<br/>Enable pipeline"]

            subgraph CORE["md_top (rtl/prei/md_top.v:7)"]
                direction TB
                MDTOP2["md_top<br/>Gradient + Angular Cost<br/>+ Comparison + DC/Planar"]

                subgraph FETCH_SUB["Pixel Fetch"]
                    FETCH8["fetch8x8<br/>(rtl/prei/fetch8x8.v:9)<br/>8×8 block fetch<br/>512-bit register"]
                    MDFETCH["md_fetch<br/>(rtl/prei/md_fetch.v:7)<br/>x1/x2/x3 extraction<br/>3×(3×8-bit)"]
                end

                subgraph GRAD_SUB["Gradient + Cost"]
                    GXGY["gxgy<br/>(rtl/prei/gxgy.v:7)<br/>Sobel gradient<br/>gx[10:0], gy[10:0]"]
                    COUNTER["counter<br/>(rtl/prei/counter.v:4)<br/>32 angular modes<br/>mode2..mode33[21:0]"]
                end

                subgraph DECIDE_SUB["Decision"]
                    COMPARE["compare<br/>(rtl/prei/compare.v:7)<br/>Best angle: 8→16→32→64<br/>bestmode, modebest"]
                    DCPLANAR["dc_planar<br/>(rtl/prei/DC_Plannar.v:7)<br/>DC/Planar vs Angle<br/>bestmode_o/16/32/64_o"]
                end

                subgraph CTRL_SUB["Control + Write"]
                    CTRL["control<br/>(rtl/prei/control.v:11)<br/>cyclecnt[5:0]: 0→40<br/>blockcnt[6:0]: 0→65"]
                    MODWRITE["mode_write<br/>(rtl/prei/mode_write.v:9)<br/>md_we, md_waddr[6:0]<br/>md_wdata[5:0]"]
                end
            end
        end

        subgraph RC["rate_control — Rate Control"]
            RC_MOD["rate_control<br/>(rtl/prei/rate_control.v:22)<br/>11-cycle pipeline<br/>QP adjustment + ROI"]
        end
    end

    %% Hierarchy connections
    BUF_LABEL --> TOP_LABEL
    TOP_LABEL --> MDTOP
    MDTOP --> MDTOP2
    MDTOP2 --> FETCH8
    MDTOP2 --> MDFETCH
    MDTOP2 --> GXGY
    MDTOP2 --> COUNTER
    MDTOP2 --> COMPARE
    MDTOP2 --> DCPLANAR
    MDTOP2 --> CTRL
    MDTOP2 --> MODWRITE

    %% RAM connections
    TOP_LABEL -->|"md_we, md_waddr,<br/>md_wdata"| RAM0
    TOP_LABEL -->|"md_we, md_waddr,<br/>md_wdata"| RAM1
    REMAP --> RAM0
    REMAP --> RAM1

    %% RC connection
    TOP_LABEL -->|"md_done_w"| RC_MOD
    RC_MOD -.->|"rc_done_o"| TOP_LABEL

    %% Style
    classDef wrapper fill:#4a90d9,stroke:#2c5f8a,color:#fff,font-weight:bold
    classDef core fill:#d9534f,stroke:#a94442,color:#fff,font-weight:bold
    classDef fetch fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef gradient fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef decision fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef ctrl fill:#e8a838,stroke:#b07d28,color:#000
    classDef rc fill:#27ae60,stroke:#1e8449,color:#fff
    classDef mem fill:#5cb85c,stroke:#3d8b3d,color:#fff

    class BUF_LABEL,TOP_LABEL,MDTOP,MDTOP2 wrapper
    class GXGY,COUNTER,COMPARE,DCPLANAR,MDFETCH fetch
    class FETCH8 fetch
    class CTRL,MODWRITE ctrl
    class RC_MOD,RC rc
    class RAM0,RAM1 mem
    class REMAP wrapper
