    style PIPELINE_CTRL fill:#eee,stroke:#999,stroke-width:1px
    style FETCH_HUB fill:#eef,stroke:#666,stroke-width:1px
    style STAGE_0 fill:#fdd,stroke:#999,stroke-width:1px,stroke-dasharray:5,5
    style STAGE_1 fill:#fdf,stroke:#999,stroke-width:1px,stroke-dasharray:5,5
    style STAGE_2 fill:#dff,stroke:#999,stroke-width:1px,stroke-dasharray:5,5
    style STAGE_3 fill:#fed,stroke:#999,stroke-width:1px,stroke-dasharray:5,5
    style STAGE_4 fill:#dfd,stroke:#999,stroke-width:1px,stroke-dasharray:5,5
    style STAGE_5 fill:#fde,stroke:#999,stroke-width:1px,stroke-dasharray:5,5
